# ---------------------------------------------
# Tech Curious Server Environment Configuration
# ---------------------------------------------

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/tech-curious
JWT_SECRET=tech_curious_super_secret_jwt_key_2026_dev_mode
CLIENT_URL=http://localhost:5173

# Admin Access & Contact Recipient (Comma-separated for multiple admin emails)
ADMIN_EMAIL=admin@techcurious.com
CONTACT_RECEIVER_EMAIL=admin@techcurious.com

# Resend Email Integration (Recommended: For Contact Form & CMS Admin OTP Login)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=
# Sender: Use 'Tech Curious <onboarding@resend.dev>' for free testing or 'Tech Curious <noreply@yourdomain.com>'
RESEND_FROM_EMAIL=Tech Curious <onboarding@resend.dev>

# Optional: Gmail Nodemailer Fallback (If RESEND_API_KEY is not provided)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Cloudinary for Project Image Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
